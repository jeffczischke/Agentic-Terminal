# Copy this file to .env and fill in your values. .env is gitignored.
# Never commit a real API key. If one is ever exposed, regenerate it at
# unusualwhales.com/settings/api-dashboard (refreshing deactivates the old token).

# Required: your Unusual Whales REST API key.
UW_API_KEY=

# Optional: REST throttle and retry behaviour (defaults shown).
UW_RATE_LIMIT_PER_MINUTE=120
UW_MAX_RETRIES=3

# Optional: Robinhood account number for the equity panel (read-only context).
RH_ACCOUNT_NUMBER=
